{
  // The public site on Cloudflare Pages: the built web app (../dist) plus the
  // API as a Pages Function. Durable Objects come from the private
  // shuttersense-core Worker (../wrangler.jsonc), which has no public URL.
  // Deploy with `npm run deploy` from the repository root.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shuttersense",
  "pages_build_output_dir": "../dist",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room", "script_name": "shuttersense-core" },
      { "name": "BUDGET", "class_name": "Budget", "script_name": "shuttersense-core" },
      { "name": "LIMITER", "class_name": "Limiter", "script_name": "shuttersense-core" },
      { "name": "PAIR", "class_name": "PairSlot", "script_name": "shuttersense-core" }
    ]
  },
  "vars": { "AGENT_MODEL": "muse-wonder-1.0" }
}
