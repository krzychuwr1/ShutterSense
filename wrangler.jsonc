{
  // One Worker: the web app as static assets, /api/* handled by worker/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-shooter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "BUDGET", "class_name": "Budget" },
      { "name": "LIMITER", "class_name": "Limiter" },
      { "name": "PAIR", "class_name": "PairSlot" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Budget", "Limiter", "PairSlot"] }],
  "vars": { "AGENT_MODEL": "muse-wonder-1.0" },
  "observability": { "enabled": true }
}
